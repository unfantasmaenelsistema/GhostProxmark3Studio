# GEMINI_API_KEY: clave de Google AI Studio (https://aistudio.google.com/).
# Opcional: sin ella, el Copiloto IA funciona en modo experto offline con
# recomendaciones preprogramadas sobre la wiki de Iceman.
GEMINI_API_KEY=

# PORT: puerto en el que escucha el servidor local. Por defecto 3000.
PORT=3000

# HOST: interfaz de red en la que escucha el servidor. Por defecto 127.0.0.1
# (solo tu propio equipo). Cambialo a 0.0.0.0 únicamente si sabes lo que
# haces y entiendes que expones la app a otros equipos de tu red.
HOST=127.0.0.1

# MAX_BODY_SIZE: límite de tamaño para las peticiones JSON. Por defecto 10mb.
MAX_BODY_SIZE=10mb
